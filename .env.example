# Required authentication configuration. Replace every placeholder before startup.
VOD_DASHBOARD_USERNAME=replace-with-admin-username
# Keep the hash single-quoted so Compose treats its dollar signs literally.
VOD_DASHBOARD_PASSWORD_HASH='replace-with-a-werkzeug-password-hash'
VOD_DASHBOARD_SECRET_KEY='replace-with-a-random-value-of-at-least-32-characters'

# Docker paths. Keep the media root inside the /downloads mount.
VOD_DASHBOARD_MEDIA_ROOT=/downloads
VOD_DASHBOARD_TWITCH_COOKIE_FILE=
# Optional one-time migration source. Use an explicit file inside a mounted path.
VOD_DASHBOARD_LEGACY_SETTINGS_PATH=
# Docker cannot complete the browser callback reliably. Keep this as external
# and run the documented native bootstrap command to create the token.
VOD_DASHBOARD_YOUTUBE_OAUTH_MODE=external

# Direct local HTTP defaults. Set the secure cookie flag to 1 behind HTTPS.
VOD_DASHBOARD_SESSION_COOKIE_SECURE=0
VOD_DASHBOARD_ALLOWED_ORIGINS=
VOD_DASHBOARD_TRUSTED_HOSTS=localhost,127.0.0.1

# Container/runtime options.
TZ=UTC
PUID=1000
PGID=1000
VOD_DASHBOARD_PORT=8787

# Optional Traefik example values; fill these only when using its override file.
VOD_DASHBOARD_HOSTNAME=
VOD_DASHBOARD_CERT_RESOLVER=
VOD_DASHBOARD_TRAEFIK_NETWORK=
